# ============================================
# MAGNY FC 78 - Configuration Environnement
# ============================================
# Copier ce fichier vers .env.development ou .env.production
# et remplir avec vos valeurs

# Environnement (development | production | test)
NODE_ENV=development

# Serveur
PORT=3000
HOST=localhost

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=magny_fc_78

# JWT (Générer avec: npm run generate-secret)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Sécurité
BCRYPT_ROUNDS=12

# Session
SESSION_SECRET=your_session_secret_key_here
COOKIE_SECURE=false

# Logs
LOG_LEVEL=info

# ============================================
# URL publique (liens dans les emails)
# ============================================
# Par défaut http://localhost:<PORT>
PUBLIC_URL=http://localhost:3000

# ============================================
# Email (inscription, vérification, invitations, reset mot de passe)
# ============================================
# EMAIL_ENABLED=false -> mode DEV : aucun envoi réel, contenu loggué.
# EMAIL_ENABLED=true  -> envoi via le SMTP ci-dessous.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Magny FC 78 <no-reply@magnyfc78.fr>
